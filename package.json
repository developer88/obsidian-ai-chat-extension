{
  "name": "sidecar-ai",
  "version": "3.6.0",
  "description": "Native Obsidian AI chat sidebar powered by Google Antigravity, GitHub Copilot, Pi Coding Agent, and Custom CLIs",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit --skipLibCheck",
