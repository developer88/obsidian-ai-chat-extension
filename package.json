  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.9",
    "esbuild": "0.28.1",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "latest",
    "tslib": "2.6.3",
    "tsx": "^4.23.13",
    "typescript": "5.5.2"
  }
}
